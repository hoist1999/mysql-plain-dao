{
  "name": "mysql-plain-dao",
  "version": "0.1.2-beta.9",
  "description": "A plain dao for mysql, no ORM, just plain sql",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.js"
    },
    "./generator": {
      "types": "./dist/generator/index.d.mts",
      "default": "./dist/generator/index.js"
    }
  },
  "bin": {
    "mysql-plain-dao": "./dist/generator/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "NODE_ENV=test-local DEBUG=-DAO jest --runInBand",
    "test-in-docker": "NODE_ENV=test-in-docker DEBUG=-DAO jest --runInBand",
    "prepublishOnly": "pnpm build",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "start": "tsx src/generator/cli.ts",
    "release": "bumpp package.json --commit --push --tag"
  },
  "keywords": [
    "typescript",
    "mysql",
    "DAO",
    "plain sql"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.24",
    "bumpp": "^10.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoist1999/mysql-plain-dao.git"
  },
  "bugs": {
    "url": "https://github.com/hoist1999/mysql-plain-dao/issues"
  },
  "homepage": "https://github.com/hoist1999/mysql-plain-dao#readme",
  "dependencies": {
    "@types/debug": "^4.1.12",
    "@types/lodash": "^4.17.15",
    "@types/pluralize": "^0.0.33",
    "@types/sqlstring": "^2.3.2",
    "@types/yargs": "^17.0.33",
    "commander": "^13.1.0",
    "dao": "link:/Users/ike-tom/sites/mysql-plain-dao/src/dao",
    "debug": "^4.4.0",
    "dotenv-flow": "^4.1.0",
    "lodash": "^4.17.21",
    "mysql2": "^3.12.0",
    "pg-promise": "^11.10.2",
    "pluralize": "^8.0.0",
    "sqlstring": "^2.3.3",
    "typescript-formatter": "^7.2.2",
    "yargs": "^17.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}