{
    "extends": "@tsconfig/node18/tsconfig.json",
    "compilerOptions": {
        "declaration": true,
        "removeComments": false,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "sourceMap": true,
        "baseUrl": "./",
        "incremental": true
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "src/__tests__"
    ]
}