FROM node:20-slim

# Install pnpm using npm
RUN npm install -g pnpm

# Install tree command
RUN apt-get update && apt-get install -y tree

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml* ./

# Install dependencies - This layer will be cached unless package.json or pnpm-lock.yaml changes
RUN pnpm install --frozen-lockfile

# Copy source code - This layer contains frequently changing source code
COPY . .